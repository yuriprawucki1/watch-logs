{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.vscode",
			"!**/.husky",
			"!**/.env",
			"!**/.env.local"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn",
				"noUselessStringConcat": "warn",
				"noUselessUndefinedInitialization": "warn",
				"useDateNow": "warn",
				"useSimplifiedLogicExpression": "warn",
				"noUselessEscapeInRegex": "error",
				"noUselessStringRaw": "warn"
			},
			"correctness": {
				"noConstantMathMinMaxClamp": "warn",
				"noUnusedImports": "warn",
				"noUnusedPrivateClassMembers": "warn",
				"noUnusedVariables": "warn",
				"useHookAtTopLevel": "error",
				"noInvalidBuiltinInstantiation": "warn",
				"noMissingVarFunction": "warn",
				"noUnknownPseudoClass": "error",
				"noUnknownTypeSelector": "error"
			},
			"nursery": {
				"useExplicitType": "error",
				"useSortedClasses": "warn"
			},
			"performance": {
				"noBarrelFile": "error",
				"noReExportAll": "error",
				"useTopLevelRegex": "warn",
				"noDynamicNamespaceImportAccess": "error",
				"noImgElement": "error",
				"noNamespaceImport": "error"
			},
			"style": {
				"noDoneCallback": "warn",
				"noNamespace": "error",
				"noNegationElse": "warn",
				"noShoutyConstants": "error",
				"noUnusedTemplateLiteral": "warn",
				"noYodaExpression": "warn",
				"useBlockStatements": "warn",
				"useCollapsedElseIf": "warn",
				"useConsistentArrayType": {
					"level": "warn",
					"options": {
						"syntax": "shorthand"
					}
				},
				"useConsistentBuiltinInstantiation": "warn",
				"useDefaultSwitchClause": "warn",
				"useExplicitLengthCheck": "warn",
				"useForOf": "warn",
				"useFragmentSyntax": "warn",
				"useNodeAssertStrict": "warn",
				"useShorthandAssign": "warn",
				"useThrowNewError": "warn",
				"useThrowOnlyError": "error",
				"useArrayLiterals": "warn",
				"noCommonJs": "error",
				"noDescendingSpecificity": "warn",
				"noEnum": "warn",
				"noExportedImports": "warn",
				"noHeadElement": "error",
				"noNestedTernary": "error",
				"noProcessEnv": "error",
				"noSubstr": "error",
				"noValueAtRule": "error",
				"useAtIndex": "warn",
				"useCollapsedIf": "warn",
				"useComponentExportOnlyModules": "warn",
				"useConsistentCurlyBraces": "error",
				"useDeprecatedReason": "error",
				"useTrimStartEnd": "warn"
			},
			"suspicious": {
				"noConsole": "warn",
				"noEmptyBlockStatements": "warn",
				"noEvolvingTypes": "warn",
				"noMisplacedAssertion": "warn",
				"noSkippedTests": "warn",
				"useAwait": "warn",
				"useErrorMessage": "error",
				"useNumberToFixedDigitsArgument": "error",
				"noDocumentCookie": "warn",
				"noDocumentImportInPage": "warn",
				"noDuplicateCustomProperties": "warn",
				"noDuplicateElseIf": "error",
				"noDuplicateProperties": "error",
				"noHeadImportInDocument": "error",
				"noIrregularWhitespace": "error",
				"noOctalEscape": "error",
				"noTemplateCurlyInString": "warn",
				"useAdjacentOverloadSignatures": "warn",
				"useGoogleFontDisplay": "warn",
				"useGuardForIn": "warn",
				"useStrictMode": "warn"
			},
			"security": {
				"noSecrets": "error"
			},
			"a11y": {
				"noStaticElementInteractions": "error",
				"useAriaPropsSupportedByRole": "warn",
				"useValidAutocomplete": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 80,
		"attributePosition": "auto",
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "asNeeded",
			"trailingCommas": "es5"
		}
	}
}
