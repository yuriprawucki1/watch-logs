    "@commitlint/config-conventional": "21.2.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "czg": "1.14.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
